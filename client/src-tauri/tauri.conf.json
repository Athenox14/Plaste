{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plaste Sync",
  "version": "0.1.0",
  "identifier": "com.plaste.sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plaste Sync",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://example.invalid/plaste/updates/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_GENERATED_UPDATER_PUBKEY"
    }
  }
}
